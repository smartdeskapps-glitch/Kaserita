{
  "buildCommand": "npm test && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://hzmrsbeamtbloudmxjrp.supabase.co https://api.qrserver.com; media-src 'self' data: blob: https://cdn.pixabay.com; connect-src 'self' https://hzmrsbeamtbloudmxjrp.supabase.co wss://hzmrsbeamtbloudmxjrp.supabase.co https://cdn.jsdelivr.net; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(como-funciona-delivery.jpg|como-funciona-delivery-780.webp|como-funciona-delivery-1200.webp|pos-pantalla.webp|pos-celular-mujer.webp|pos-celular-pantalla.webp|registro-mujer.webp|pos-dashboard.webp|pos-cuentas.webp|og-image.jpg|logo-blanco.webp|logo-blanco-wordmark.png|icon-192.png|icon-512.png|icon.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(splash-pos.js|sw-registro.js|inicio.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kaserita.vercel.app" }],
      "destination": "https://kaserita.smartdeskapps.com/:path*",
      "permanent": true
    },
    { "source": "/demo", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/pos", "destination": "/pos.html" },
    { "source": "/registro", "destination": "/registro.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/terminos-delivery", "destination": "/terminos-delivery.html" },
    { "source": "/reclamos", "destination": "/reclamos.html" },
    { "source": "/favicon.ico", "destination": "/icon-192.png" }
  ]
}
